# === Обязательные ===
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключи EcoFlow Developer Platform: https://developer-eu.ecoflow.com/ → Security
ECOFLOW_ACCESS_KEY=
ECOFLOW_SECRET_KEY=
# Серийный номер EcoFlow DELTA Pro 3 (начинается с MR51...)
ECOFLOW_DEVICE_SN=

# === Доступ и уведомления ===
# Telegram ID через запятую, кому разрешено пользоваться ботом (узнать: команда /id в боте).
# Пусто — бот отвечает всем. Этим же людям приходят уведомления.
ALLOWED_USER_IDS=
# Куда слать уведомления, если нужно отдельно (ID пользователей или групп через запятую).
NOTIFY_CHAT_IDS=
# Как часто проверять станцию и график, секунд (минимум 30)
MONITOR_INTERVAL_SEC=60
# Уведомлять, когда заряд при работе от батареи ниже этого уровня, %
LOW_BATTERY_SOC=20
# Уведомлять об изменениях графика ДТЭК (1 — да, 0 — нет)
NOTIFY_SCHEDULE_CHANGES=1

# === ДТЭК ===
DTEK_REGION=dnipro
DTEK_GROUP=3.1

# === EcoFlow ===
# Европа: https://api-e.ecoflow.com, США: https://api-a.ecoflow.com
ECOFLOW_API_HOST=https://api-e.ecoflow.com
# Емкость: 4096 (одна станция), 8192 / 12288 с доп. батареями
DELTA_PRO_3_CAPACITY_WH=4096
